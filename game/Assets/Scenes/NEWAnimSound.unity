  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb0115ab550010248ad569d0116cf47c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  DialogueBox: {fileID: 1315331578}
  NameBox: {fileID: 1666416504}
  DialogueText: {fileID: 581765100}
  NameText: {fileID: 2061986584}
  DialogueLines:
  - "Marriage this, marriage that. What if I don\u2019t WANT to marry?"
  - Oh! Little one you scared me. Say, do you know how to get me out of this date
    my brothers set up?
  - Oh! You're amazing, little one. I may just yet be the next head of the factory.
  NPCName: Margret
  TypeSpeed: 0.05
  _LineDelay: 2
  _EndDelay: 7
  height: 2
