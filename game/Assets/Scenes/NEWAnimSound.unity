  m_Script: {fileID: 11500000, guid: eb0115ab550010248ad569d0116cf47c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  DialogueBox: {fileID: 1315331578}
  NameBox: {fileID: 1666416504}
  DialogueText: {fileID: 581765100}
  NameText: {fileID: 2061986584}
  DialogueLines:
  - Mother, you are exhausted and ill. We cannot keep this up, we must run.
  - "Miss? You\u2019re here again? Surely, not to help us\u2026"
  - "Ah, but, I suppose that means this is the last you\u2019ll see of us."
  - May you have steady and safe travels, and I will do my best to pay your kindness
    forward.
  NPCName: Peter
  TypeSpeed: 0.05
  _LineDelay: 2
  _EndDelay: 7
  height: 2
