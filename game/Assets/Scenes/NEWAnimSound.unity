  NameBox: {fileID: 1666416504}
  DialogueText: {fileID: 581765100}
  NameText: {fileID: 2061986584}
  DialogueLines:
  - "Lord Thomas please, I can\u2019t afford your break fees."
  - "Miss? What am I to do? I'm punished for resting but I can\u2019t possibly finish
    harvesting the field."
  - Oh! You're amazing, Miss. You always seem to appear right when I need you, thank
    you.
  NPCName: Peter
  TypeSpeed: 0.05
  _LineDelay: 2
  _EndDelay: 7
  height: 2
