  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  DialogueBox: {fileID: 1315331578}
  NameBox: {fileID: 1666416504}
  DialogueText: {fileID: 581765100}
  NameText: {fileID: 2061986584}
  DialogueLines:
  - Father please, you know I am capable. If you would just give me a chance.
  - <i>sigh</i> Hello, little one. I am once again sidelined for my fathers pride.
  - ' If you know any mind changing magic, that would be appreciated.'
  - Wow! You really do work wonders.
  - Thank you little one, if there's anything you need from me, please let me know.
  NPCName: Margret
  TypeSpeed: 0.05
