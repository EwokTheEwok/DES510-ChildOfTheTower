  DialogueText: {fileID: 581765100}
  NameText: {fileID: 2061986584}
  DialogueLines:
  - "Thomas please, you\u2019re scaring me. This design is what you asked of me."
  - "I don\u2019t know what to do, I don\u2019t know what he wants."
  - "Oh little one you\u2019re back. You\u2019ll keep me safe won\u2019t you?"
  NPCName: Margret
