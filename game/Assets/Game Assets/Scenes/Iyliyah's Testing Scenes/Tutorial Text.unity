  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  DialogueLines:
  - "Please, I just want to go home. I don\u2019t want to die here."
  - "\u201CYou again? How kind of you to appear, but I doubt your light can help
    me escape death."
  - Huh, I suppose you do have more surprises. Thank you, Miss.
  NPCName: Peter
